{
  "name": "bhumi-satya-backend",
  "version": "1.0.0",
  "description": "Bhumi Satya Digital Twin Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"src/**/*.test.js\"",
    "test:integration": "node --test \"integration/**/*.test.js\"",
    "audit:integration": "node scripts/audit-integration-baseline.js",
    "audit:integration:json": "node scripts/audit-integration-baseline.js --json",
    "reconcile:integration": "node scripts/reconcile-integration-data.js",
    "reconcile:integration:json": "node scripts/reconcile-integration-data.js --json",
    "reconcile:integration:apply": "node scripts/reconcile-integration-data.js --apply",
    "verify:epic1-schema": "node scripts/verify-epic1-schema.js",
    "verify:epic2-data": "node scripts/verify-epic2-data.js",
    "verify:epic3-roles": "node scripts/verify-epic3-roles.js",
    "verify:epic4-audit": "node scripts/verify-epic4-audit.js",
    "backup:verify": "node scripts/verify-backup-roundtrip.js",
    "model3d:worker": "node scripts/process-model3d-conversion-queue.js",
    "model3d:worker:once": "node scripts/process-model3d-conversion-queue.js --once",
    "model3d:schema:verify": "node scripts/verify-model3d-schema.js",
    "model3d:pipeline:verify": "node scripts/verify-model3d-pipeline.js",
    "model3d:external:verify": "node scripts/verify-model3d-external-e2e.js",
    "model3d:visual:smoke": "node scripts/manage-model3d-visual-smoke.js",
    "seed": "node seed.js",
    "db:migrate": "sequelize-cli db:migrate",
    "vercel-build": "npm run db:migrate",
    "db:migrate:one": "node scripts/apply-named-migration.js",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@supabase/supabase-js": "^2.99.1",
    "assimpjs": "^0.0.10",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fflate": "^0.8.2",
    "jsonwebtoken": "^9.0.0",
    "meshoptimizer": "^1.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "otpauth": "^9.5.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "sequelize": "^6.35.2",
    "sequelize-cli": "^6.6.1"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
